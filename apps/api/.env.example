PORT=3171
# No Railway, referencie o serviço Postgres para preencher DATABASE_URL.
DATABASE_URL=

# Credenciais do serviço de consulta CNPJ contratado junto à Receita Federal.
# Informe a URL-base da operação contratada; a API acrescenta /:cnpj ao final.
RFB_CNPJ_API_URL=
RFB_CNPJ_API_TOKEN=

# Cloudflare R2: bucket privado para a aplicação.
# Crie um token com Object Read & Write restrito a este bucket.
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=exporta-brasil-assets
# Domínio público configurado para o bucket, sem barra ao final.
R2_PUBLIC_URL=https://assets.seudominio.com
OPENAI_API_KEY=
NCM_AI_MODEL=gpt-6.1-sol

# Google Cloud Translation Basic (NMT). Enable Cloud Translation API in Google Cloud.
# Restrict this backend key to the Cloud Translation API. Not the Gemini key.
GOOGLE_TRANSLATE_API_KEY=
